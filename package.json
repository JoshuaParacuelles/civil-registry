{
  "name": "civil-registry",
  "productName": "Civil Registry System",
  "description": "Civil Registry System",
  "author": "Civil Registry Team",
  "private": true,
  "version": "1.0.40",
  "type": "module",
  "main": "electron/main.cjs",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend:build": "cd backend && python -m PyInstaller --noconfirm --onefile --name backend app.py",
    "electron:build": "cross-env ELECTRON=1 VITE_API_BASE_URL=https://civil-registry-backend.onrender.com vite build && electron-builder --win nsis --publish never",
    "electron:release": "cross-env ELECTRON=1 VITE_API_BASE_URL=https://civil-registry-backend.onrender.com vite build && electron-builder --win nsis --publish always",
    "electron:start": "electron electron/main.cjs"
  },
  "build": {
    "appId": "ph.civilregistry.desktop",
    "productName": "Civil Registry System",
    "directories": {
      "output": "release-1.0.35",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend-server",
        "filter": [
          "backend.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "paracuellesjoshua51-archwqe",
        "repo": "civil-registry",
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Civil Registry System",
      "artifactName": "Civil-Registry-System-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  }
}